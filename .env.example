# ========================================================
# ProgressBridge AI - Production Environment Configuration
# ========================================================

# --------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite + React)
# --------------------------------------------------------
# Set to your deployed backend public URL (e.g. on Render)
# Leave empty during local development to use Vite's proxy
VITE_API_URL=https://progressbridge-api.onrender.com

# --------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Node.js + Express)
# --------------------------------------------------------
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/progressbridge?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_sih2026_production
AI_SERVICE_URL=https://progressbridge-ai.onrender.com
CORS_ORIGIN=https://progressbridge-ai.vercel.app

# --------------------------------------------------------
# 3. AI SERVICE ENVIRONMENT VARIABLES (Python + FastAPI)
# --------------------------------------------------------
PORT=8000
MODEL_NAME=all-MiniLM-L6-v2
